# Copier ce fichier en .env.local (jamais commité) puis remplir les valeurs.

# --- Claude (obligatoire pour /api/chat) ---------------------------------------
# Clé créée sur https://platform.claude.com (Settings > API keys).
ANTHROPIC_API_KEY=

# --- Base de données -------------------------------------------------------------
# Vide = PGlite local (Postgres embarqué, fichier .data/pglite), rien à installer.
# En production : chaîne de connexion Neon (ou Supabase) avec pgvector, par exemple
# postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# --- Embeddings --------------------------------------------------------------------
# local  : Xenova/multilingual-e5-small via transformers.js (aucune clé, défaut)
# voyage : voyage-4 via l'API Voyage AI / MongoDB Atlas (nécessite VOYAGE_API_KEY)
# Changer de fournisseur impose de relancer `npm run ingest`.
EMBEDDING_PROVIDER=local
VOYAGE_API_KEY=
